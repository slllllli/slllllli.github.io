<%
  const navItems = [
    { key: 'home', path: '/' },
    { key: 'archives', path: '/archives/' },
    { key: 'topics', path: '/topics/' },
    { key: 'about', path: '/about/' }
  ];
  const homePath = localized_path('/', lang);
  const switchPath = alt_path(page);
  const switchLang = alt_lang(page);
  const github = theme.links && theme.links.github;
%>
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="<%= url_for(homePath) %>" aria-label="<%= site_title(lang) %>">
      <span class="brand-mark" aria-hidden="true"><%= t('brand.mark', lang) %></span>
      <span class="brand-text">
        <span class="brand-name"><%= site_title(lang) %></span>
        <span class="brand-sub"><%= lang === 'zh' ? '论文精读笔记' : 'paper notes' %></span>
      </span>
    </a>

    <nav class="site-nav" id="site-nav" aria-label="<%= lang === 'zh' ? '主导航' : 'Main navigation' %>">
      <% navItems.forEach(function(item) { %>
        <a class="nav-link<%= nav_active(page, item.key) ? ' is-active' : '' %>"
           href="<%= url_for(localized_path(item.path, lang)) %>"
           <% if (nav_active(page, item.key)) { %>aria-current="page"<% } %>>
          <%= t('nav.' + item.key, lang) %>
        </a>
      <% }); %>
    </nav>

    <div class="header-actions">
      <% if (github) { %>
        <a class="icon-link github-link" href="<%= github %>" target="_blank" rel="noopener noreferrer" aria-label="<%= t('header.github', lang) %>" title="<%= t('header.github', lang) %>">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 .7a11.3 11.3 0 0 0-3.57 22.02c.57.1.78-.25.78-.55v-2.13c-3.17.69-3.84-1.34-3.84-1.34-.52-1.31-1.27-1.66-1.27-1.66-1.04-.71.08-.7.08-.7 1.15.08 1.75 1.18 1.75 1.18 1.02 1.75 2.68 1.24 3.33.95.1-.74.4-1.24.72-1.53-2.53-.29-5.2-1.27-5.2-5.64 0-1.25.45-2.26 1.18-3.06-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.14 1.17a10.9 10.9 0 0 1 5.72 0c2.18-1.48 3.14-1.17 3.14-1.17.62 1.57.23 2.73.11 3.02.73.8 1.18 1.81 1.18 3.06 0 4.38-2.68 5.35-5.22 5.63.41.36.77 1.06.77 2.13v3.16c0 .3.21.66.79.55A11.3 11.3 0 0 0 12 .7Z"/></svg>
        </a>
      <% } %>

      <a class="lang-switch" href="<%= url_for(switchPath) %>" hreflang="<%= switchLang === 'zh' ? 'zh-CN' : 'en' %>" aria-label="<%= t('lang.switch', lang) %>" title="<%= t('lang.switch', lang) %>">
        <span class="lang-option<%= lang === 'en' ? ' is-active' : '' %>">EN</span>
        <span class="lang-divider" aria-hidden="true">/</span>
        <span class="lang-option<%= lang === 'zh' ? ' is-active' : '' %>">中文</span>
      </a>

      <button class="icon-button theme-toggle" type="button" aria-label="<%= t('theme.toggle', lang) %>" title="<%= t('theme.toggle', lang) %>">
        <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
        <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 14.3A8.5 8.5 0 0 1 9.7 4a8.5 8.5 0 1 0 10.3 10.3Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
      </button>

      <button class="icon-button nav-toggle" type="button" aria-controls="site-nav" aria-expanded="false" aria-label="<%= t('header.menu', lang) %>">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>
